# OLT Connection Configuration
# Copy this file to .env and fill in your actual values

# --- OLT Device Info ---
OLT_IP=192.168.1.1
OLT_NAME=Hioso OLT-8X
OLT_LOCATION=Data Center A
OLT_MODEL=OLT-8X-PON

# --- SNMP Settings ---
# Set to 'true' to use SNMP for data collection (recommended)
# SNMP_VERSION: 0=v1, 1=v2c, 3=v3 (nilai '2' juga dipetakan ke v2c)
SNMP_COMMUNITY=public
SNMP_VERSION=1
SNMP_PORT=161
SNMP_TIMEOUT=5000
SNMP_RETRIES=1

# --- SSH Settings ---
# Set USE_SSH=true to use SSH/CLI instead of SNMP
USE_SSH=false
SSH_PORT=22
SSH_USER=admin
SSH_PASS=

# --- Polling Interval (seconds) ---
POLL_INTERVAL=30

# --- Fallback ---
# true  = pakai data mock saat OLT gagal dibaca
# false = tampilkan error asli (direkomendasikan untuk troubleshooting)
MOCK_FALLBACK=true

# --- API Server Port ---
API_PORT=5000
